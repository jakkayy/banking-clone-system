# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=banking_user
DB_PASSWORD=banking_password
DB_NAME=banking_db

# Redis
REDIS_URL=localhost:6380

# JWT
# Must be a random string of at least 32 characters (e.g. openssl rand -hex 32)
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-chars
JWT_EXPIRY=24h

# Server
SERVER_PORT=8080
GIN_MODE=debug

# CORS — set to your frontend origin in production (e.g. https://yourapp.vercel.app)
CORS_ORIGIN=http://localhost:3000
